---
import { STORE_URLS } from '../data/site';
---

<section id="descarga" class="pt-15 pb-10">
  <div class="mx-auto max-w-[1140px] px-6">
    <div class="relative overflow-hidden rounded-[32px] bg-[#0E7DB8] px-6 py-16 text-center text-white shadow-[0_30px_80px_rgba(14,125,184,.3)] sm:px-10">
      <div class="absolute -top-30 -left-25 size-90 rounded-full bg-[#45B8F2] opacity-50 blur-[60px]"></div>
      <div class="absolute -right-20 -bottom-35 size-75 rounded-full bg-[#25B77A] opacity-50 blur-[60px]"></div>

      <div class="relative">
        <h2 class="text-[clamp(28px,3.6vw,42px)] font-extrabold">Tu próximo súper, con menos letra chica.</h2>
        <p class="mx-auto mt-3 mb-7 max-w-[46ch] text-[#DDF1FF]">
          Sano es gratis, sin anuncios y sin tarjeta. Descárgala, crea tu perfil en un minuto y escanea lo que quieras.
        </p>

        <div class="flex flex-wrap justify-center gap-3">
          <a href={STORE_URLS.ios} class="flex items-center gap-2.5 rounded-xl bg-[#071A2F] px-4.5 py-2.5 text-left leading-tight text-white transition-transform hover:-translate-y-px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.8-1.7 0-3.2 1-4.1 2.5-1.8 3-.5 7.6 1.3 10.1.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.9-4.1zM14 5.2c.7-.8 1.2-2 1-3.2-1 0-2.2.7-3 1.5-.6.7-1.2 1.9-1 3.1 1.1.1 2.3-.6 3-1.4z"></path></svg>
            <span><small class="block text-[10px] opacity-70">Descargar en</small><b class="font-display text-[15px]">App Store</b></span>
          </a>
          <a href={STORE_URLS.android} class="flex items-center gap-2.5 rounded-xl bg-[#071A2F] px-4.5 py-2.5 text-left leading-tight text-white transition-transform hover:-translate-y-px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.3 13 12l-9.4 9.7c-.3-.2-.6-.6-.6-1.2V3.5c0-.6.3-1 .6-1.2zM14.5 13.5l2.6 2.6-9.9 5.6c-.6.3-1.2.3-1.7 0zM17.1 8 14.5 10.5 5.5 2.3c.5-.3 1.1-.3 1.7 0zm3.4 2.2c.9.5.9 1.9 0 2.4L18.3 14 15.8 12l2.5-2.4z"></path></svg>
            <span><small class="block text-[10px] opacity-70">Disponible en</small><b class="font-display text-[15px]">Google Play</b></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
