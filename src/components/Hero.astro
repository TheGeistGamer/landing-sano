---
import Icon from './Icon.astro';

const GUARANTEES = ['100% gratis', 'Sin tarjeta ni anuncios', 'Productos de México'];
---

<section class="relative pt-14 pb-10 md:pt-22">
  <div class="blob -top-30 -left-55 size-130" style="background: var(--blob1)"></div>
  <div class="blob top-10 -right-40 size-105" style="background: var(--blob2)"></div>
  <div class="blob -top-25 right-55 size-65 opacity-60!" style="background: var(--blob3)"></div>

  <div class="relative z-10 mx-auto grid max-w-[1140px] items-center gap-12 px-6 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <p class="eyebrow">Escanea · Entiende · Elige mejor</p>
      <h1 class="mt-3.5 mb-5 text-[clamp(38px,5.4vw,60px)] font-extrabold">
        Sabe lo que comes <span class="text-brand">antes de meterlo</span> al carrito.
      </h1>
      <p class="lede">
        Apunta la cámara al código de barras y en segundos obtienes una calificación de 0 a 100, qué significan
        sus sellos NOM-051 y una alternativa más sana que sí venden en tu súper.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-p" href="#descarga">Descargar gratis</a>
        <a class="btn btn-s" href="#funciones">Ver cómo funciona</a>
      </div>

      <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-mute">
        {GUARANTEES.map((g) => (
          <li class="flex items-center gap-1.5">
            <Icon name="check" size={15} strokeWidth={2.5} class="text-fresh" />
            {g}
          </li>
        ))}
      </ul>
    </div>

    <!-- Cluster de pantallas -->
    <div class="relative h-[520px] sm:h-[560px]" aria-hidden="true">
      <!-- Sellos NOM-051 -->
      <div class="shot float absolute top-0 left-0 hidden w-50 p-4 sm:block">
        <h4 class="mb-2.5 text-xs font-semibold text-ink2">Sellos NOM-051</h4>
        <div class="flex flex-wrap gap-1.5">
          <div class="seal">Exceso azúcares</div>
          <div class="seal">Exceso calorías</div>
          <div class="seal">Exceso sodio</div>
        </div>
        <p class="mt-2.5 text-[11px] leading-snug text-mute">Azúcares: 2.3× el límite recomendado por porción.</p>
      </div>

      <!-- Detalle de producto -->
      <div class="shot absolute top-5 left-1/2 h-[470px] w-59 -translate-x-[58%] p-3.5">
        <div class="mx-auto mb-3 h-1.5 w-17 rounded-full bg-line"></div>
        <p class="text-[11px] text-mute">Yogur bebible fresa · 250 ml</p>
        <p class="mt-0.5 mb-3 font-display text-sm font-bold leading-tight">Marca típica de súper</p>
        <div class="ring" style="--score: 82%">
          <b class="font-display text-[38px] leading-none font-extrabold tracking-tighter">82</b>
          <small class="text-[10px] text-mute">de 100</small>
        </div>
        <div class="my-3 text-center"><span class="tag">Buena opción para ti</span></div>
        <div class="row"><span><i class="dot bg-sc-good"></i>Proteína</span><b>8 g</b></div>
        <div class="row"><span><i class="dot bg-sc-mod"></i>Azúcares</span><b>11 g</b></div>
        <div class="row"><span><i class="dot bg-sc-ex"></i>Aditivos</span><b>0 de riesgo</b></div>
      </div>

      <!-- Aditivos -->
      <div class="shot float absolute top-24 -right-2.5 w-52.5 p-4 [animation-delay:-2s] sm:right-0">
        <h4 class="mb-2.5 text-xs font-semibold text-ink2">Aditivos</h4>
        <div class="row py-1.5!"><span><i class="dot bg-sc-ex"></i>Pectina E440</span><span class="text-fresh-700">Seguro</span></div>
        <div class="row py-1.5!"><span><i class="dot bg-sc-mod"></i>Sorbato K E202</span><span class="text-[#B45309]">Moderar</span></div>
        <div class="row py-1.5!"><span><i class="dot bg-sc-crit"></i>Tartrazina E102</span><span class="text-[#B42318]">Evitar</span></div>
      </div>

      <!-- Alternativas -->
      <div class="shot float absolute bottom-5 left-3 hidden w-47.5 p-4 [animation-delay:-4s] sm:block">
        <h4 class="mb-2.5 text-xs font-semibold text-ink2">Alternativas cerca</h4>
        <div class="flex items-center gap-2.5 py-2 text-xs">
          <span class="size-7.5 flex-none rounded-lg bg-brand-50"></span>Yogur natural sin azúcar
          <b class="ml-auto font-display text-sc-ex">91</b>
        </div>
        <div class="flex items-center gap-2.5 border-t border-line2 py-2 text-xs">
          <span class="size-7.5 flex-none rounded-lg bg-brand-50"></span>Yogur griego 0%
          <b class="ml-auto font-display text-sc-ex">88</b>
        </div>
        <p class="mt-2 text-[10px] text-faint">Disponible en Walmart y Soriana</p>
      </div>
    </div>
  </div>
</section>
