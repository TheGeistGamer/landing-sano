---
import Icon from './Icon.astro';

const BENEFITS = [
  {
    title: 'Historial con tu evolución',
    text: 'Cada producto que escaneas se guarda con su score. Ve tu tendencia semana a semana y qué se repite en tu carrito.',
  },
  {
    title: 'Modo familia',
    text: 'Un perfil para ti, otro para tus hijos, otro para tus papás. Cambia de perfil antes de escanear y el score se recalcula.',
  },
  {
    title: 'Reporte semanal',
    text: 'Un resumen cada semana: score promedio, lo que más escaneaste y cuánta azúcar o sodio dejaste fuera.',
  },
  {
    title: 'Tus datos, tuyos',
    text: 'Tu perfil de salud solo sirve para calcular tu score. No lo vendemos ni lo usamos para publicidad.',
  },
];

// Score diario de la semana (ejemplo). Escala del SVG: 0–100 → y 90–10.
const DAYS = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
const SCORES = [68, 70, 66, 73, 75, 77, 80];
const x = (i: number) => 10 + i * 50;
const y = (s: number) => 90 - ((s - 50) / 40) * 70;
const line = SCORES.map((s, i) => `${i ? 'L' : 'M'}${x(i)} ${y(s).toFixed(1)}`).join(' ');
const area = `${line} L${x(SCORES.length - 1)} 90 L${x(0)} 90 Z`;
const last = { cx: x(SCORES.length - 1), cy: y(SCORES[SCORES.length - 1]) };

const SUMMARY = [
  { label: 'Más escaneado', value: 'Pan de caja integral · 4×', cls: '' },
  { label: 'Azúcar evitada', value: '−118 g', cls: 'text-fresh-700' },
  { label: 'Alternativas elegidas', value: '3', cls: '' },
];
---

<section id="perfil" class="relative pt-5 pb-20">
  <div class="blob -bottom-25 -left-45 size-105" style="background: var(--blob1)"></div>

  <div class="relative z-10 mx-auto grid max-w-[1140px] items-center gap-16 px-6 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Un escaneo, tu contexto</p>
      <h2 class="mt-3 mb-4 text-[clamp(28px,3.4vw,38px)] font-bold">
        Diseñada para decidir <span class="text-brand">sin leer la letra chica.</span>
      </h2>
      <p class="lede mb-3">Todo lo que necesitas está a un escaneo, y nada más.</p>

      <ul>
        {BENEFITS.map((b, i) => (
          <li class:list={['flex gap-3.5 py-4.5', i > 0 && 'border-t border-line2']}>
            <Icon name="checkCircle" size={20} strokeWidth={2.5} class="mt-0.5 flex-none text-fresh" />
            <div>
              <h3 class="mb-1 text-base font-bold">{b.title}</h3>
              <p class="text-sm text-mute">{b.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Reporte semanal -->
    <div class="order-first lg:order-none" aria-hidden="true">
      <div class="shot mx-auto w-full max-w-[380px] p-5.5">
        <p class="eyebrow text-[10px]!">Reporte semanal</p>
        <div class="mt-1.5 mb-0.5 flex items-baseline gap-2.5">
          <b class="font-display text-[44px] leading-none tracking-tighter">74</b>
          <span class="tag">+6 vs. semana pasada</span>
        </div>
        <p class="text-xs text-mute">Score promedio · 8 – 14 sep</p>

        <svg viewBox="0 0 320 110" class="mt-3.5 block w-full">
          <defs>
            <linearGradient id="report-fill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#1796D8" stop-opacity=".35"></stop>
              <stop offset="1" stop-color="#1796D8" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <g stroke="var(--line2)" stroke-width="1">
            <line x1="0" y1="10" x2="320" y2="10"></line>
            <line x1="0" y1="50" x2="320" y2="50"></line>
            <line x1="0" y1="90" x2="320" y2="90"></line>
          </g>
          <path d={area} fill="url(#report-fill)"></path>
          <path d={line} fill="none" stroke="#1796D8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx={last.cx} cy={last.cy} r="4.5" fill="#1796D8" stroke="var(--card)" stroke-width="2"></circle>
          <g font-size="9" fill="var(--faint)" font-family="DM Sans, sans-serif" text-anchor="middle">
            {DAYS.map((d, i) => <text x={x(i)} y="106">{d}</text>)}
          </g>
        </svg>

        <div class="mt-2">
          {SUMMARY.map((s) => <div class="row"><span>{s.label}</span><b class={s.cls}>{s.value}</b></div>)}
        </div>
      </div>
    </div>
  </div>
</section>
