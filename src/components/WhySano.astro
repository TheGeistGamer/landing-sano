---
import Icon from './Icon.astro';

const STATS = [
  { icon: 'clock', tone: 'bg-brand-50 text-brand', value: '< 5 s', label: 'del escaneo a la decisión' },
  { icon: 'layers', tone: 'bg-fresh-50 text-fresh', value: '0–100', label: 'una sola escala para todo' },
  { icon: 'users', tone: 'bg-warm-100 text-warm-600', value: '5', label: 'perfiles de salud por cuenta' },
  { icon: 'gift', tone: 'bg-brand-100 text-brand-x', value: '$0', label: 'todas las funciones, gratis' },
] as const;

const COMPARE = [
  { label: 'Azúcares / 100 g', value: '32 g → 1 g' },
  { label: 'Fibra / 100 g', value: '2 g → 10 g' },
  { label: 'Sodio / 100 g', value: '480 mg → 5 mg' },
];

const FAMILY = [
  { name: 'Yo', score: 82, color: 'text-ink' },
  { name: 'Sofía · 7 años', score: 38, color: 'text-sc-low' },
  { name: 'Papá · diabetes', score: 21, color: 'text-sc-crit' },
];
---

<section id="porque" class="relative py-20">
  <div class="blob top-0 -right-50 size-115 opacity-55!" style="background: var(--blob3)"></div>

  <div class="relative z-10 mx-auto grid max-w-[1140px] items-center gap-16 px-6 lg:grid-cols-2">
    <!-- Comparador -->
    <div class="relative mx-auto w-full max-w-[580px]" aria-hidden="true">
      <div class="phone mx-auto h-[500px] w-[250px]">
        <div class="absolute top-4.5 left-1/2 h-5.5 w-20 -translate-x-1/2 rounded-full" style="background: var(--phone)"></div>
        <div class="phone-screen px-4 pt-9 pb-4">
          <p class="eyebrow text-[10px]!">Comparador</p>
          <p class="mt-1 font-display text-sm font-bold">Cereal para el desayuno</p>
          <p class="text-[11px] text-mute">Perfil activo: Sofía · 7 años</p>

          <div class="mt-2.5 grid grid-cols-2 gap-2">
            <div class="rounded-[14px] border border-line2 bg-card p-2.5 text-[11px] shadow-soft-sm">
              <b class="block font-display text-[28px] leading-none tracking-tighter text-sc-low">38</b>
              <span class="mt-0.5 block text-mute">Cereal chocolate</span>
              <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-line2"><i class="block h-full w-[38%] rounded-full bg-sc-low"></i></div>
              <p class="mt-2">3 sellos NOM</p>
            </div>
            <div class="rounded-[14px] border border-line2 bg-card p-2.5 text-[11px] shadow-soft-sm">
              <b class="block font-display text-[28px] leading-none tracking-tighter text-sc-ex">86</b>
              <span class="mt-0.5 block text-mute">Avena natural</span>
              <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-line2"><i class="block h-full w-[86%] rounded-full bg-sc-ex"></i></div>
              <p class="mt-2">0 sellos NOM</p>
            </div>
          </div>

          <div class="mt-3.5">
            {COMPARE.map((c) => <div class="row"><span>{c.label}</span><b>{c.value}</b></div>)}
          </div>

          <div class="mt-3.5 rounded-xl bg-brand-d p-2.5 text-center font-display text-xs font-semibold text-white">
            Elegir avena natural
          </div>
        </div>
      </div>

      <div class="shot float absolute top-40 right-0 hidden w-38 p-3 text-[11px] [animation-duration:7s] sm:block">
        <h4 class="mb-2 text-[11px] text-ink2">Modo familia</h4>
        {FAMILY.map((f) => (
          <div class="row py-1.5!"><span>{f.name}</span><b class={f.color}>{f.score}</b></div>
        ))}
      </div>
    </div>

    <div>
      <p class="eyebrow">Por qué Sano</p>
      <h2 class="mt-3 mb-4 text-[clamp(28px,3.4vw,38px)] font-bold">
        Hecho en México, para el súper <span class="text-brand">de México.</span>
      </h2>
      <p class="lede">
        Las apps europeas no conocen los sellos NOM-051 ni los productos de aquí. Sano nace con ambos integrados desde el
        primer escaneo.
      </p>

      <div class="my-7 grid gap-3.5 sm:grid-cols-2">
        {STATS.map((s) => (
          <div class="flex items-center gap-3.5 rounded-[18px] border border-line2 bg-card px-5 py-4.5 shadow-soft-sm">
            <div class:list={['grid size-10 flex-none place-items-center rounded-xl', s.tone]}>
              <Icon name={s.icon} size={20} strokeWidth={2.2} />
            </div>
            <div>
              <b class="block font-display text-[22px] leading-tight tracking-tight tabular-nums">{s.value}</b>
              <span class="text-[13px] text-mute">{s.label}</span>
            </div>
          </div>
        ))}
      </div>

      <a class="btn btn-p" href="#descarga">Descargar gratis</a>
    </div>
  </div>
</section>
