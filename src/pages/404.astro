---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada · Sano">
  <section class="mx-auto flex max-w-[560px] flex-col items-center px-6 py-28 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3 text-[clamp(32px,4.4vw,44px)] font-extrabold">Este código no está en nuestro catálogo.</h1>
    <p class="lede mt-4">La página que buscas no existe o cambió de lugar.</p>
    <a href="/" class="btn btn-p mt-8">Volver al inicio</a>
  </section>
</Layout>
