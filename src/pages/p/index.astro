---
// Destino de los enlaces que comparte la app: https://sano.infinitydev.agency/p/<código>
// Es una sola página estática; el Worker la sirve para cualquier /p/<código> y el
// código se lee en el navegador. Si la app está instalada y los Universal Links
// están activos, iOS abre la app directo y esta página ni siquiera se muestra.
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { STORE_URLS } from '../../data/site';
---

<Layout
  title="Te compartieron un producto · Sano"
  description="Abre este producto en Sano para ver su score de 0 a 100, sus sellos NOM-051 y alternativas más sanas."
>
  <section class="relative overflow-hidden">
    <div class="blob -top-30 -left-40 size-110" style="background: var(--blob1)"></div>
    <div class="blob top-20 -right-40 size-90" style="background: var(--blob2)"></div>

    <div class="relative z-10 mx-auto flex max-w-[560px] flex-col items-center px-6 pt-16 pb-24 text-center">
      <span class="grid size-16 place-items-center rounded-2xl bg-brand-d text-white shadow-[0_10px_24px_rgba(14,125,184,.3)]">
        <Icon name="scan" size={30} strokeWidth={2.2} />
      </span>

      <p class="eyebrow mt-7">Producto compartido</p>
      <h1 class="mt-3 text-[clamp(30px,5vw,42px)] font-extrabold">Te compartieron un producto en Sano</h1>
      <p class="lede mt-4">
        Ábrelo en la app para ver su score de 0 a 100, qué significan sus sellos NOM-051 y alternativas más sanas.
      </p>

      <div class="shot mt-8 flex w-full items-center gap-4 p-4 text-left">
        <span class="grid size-12 flex-none place-items-center rounded-xl bg-brand-50 text-brand">
          <Icon name="scan" size={22} />
        </span>
        <div class="min-w-0">
          <p class="text-xs text-mute">Código de barras</p>
          <p id="barcode" class="font-display text-lg font-bold tracking-wide tabular-nums">—</p>
        </div>
      </div>

      <a id="open-app" href="sano://" class="btn btn-p mt-8 w-full justify-center py-4 text-base">
        Abrir en Sano
      </a>
      <p id="open-hint" class="mt-3 hidden text-sm text-mute">
        ¿No se abrió? Instala Sano y vuelve a tocar el enlace.
      </p>

      <div class="mt-10 w-full border-t border-line2 pt-8">
        <p class="font-display text-base font-semibold">¿Aún no tienes Sano?</p>
        <p class="mt-1 text-sm text-mute">Es gratis, sin anuncios y sin tarjeta.</p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href={STORE_URLS.ios} class="flex items-center gap-2.5 rounded-xl bg-[#071A2F] px-4.5 py-2.5 text-left leading-tight text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.8-1.7 0-3.2 1-4.1 2.5-1.8 3-.5 7.6 1.3 10.1.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.9-4.1zM14 5.2c.7-.8 1.2-2 1-3.2-1 0-2.2.7-3 1.5-.6.7-1.2 1.9-1 3.1 1.1.1 2.3-.6 3-1.4z"></path></svg>
            <span><small class="block text-[10px] opacity-70">Descargar en</small><b class="font-display text-sm">App Store</b></span>
          </a>
          <a href={STORE_URLS.android} class="flex items-center gap-2.5 rounded-xl bg-[#071A2F] px-4.5 py-2.5 text-left leading-tight text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.3 13 12l-9.4 9.7c-.3-.2-.6-.6-.6-1.2V3.5c0-.6.3-1 .6-1.2zM14.5 13.5l2.6 2.6-9.9 5.6c-.6.3-1.2.3-1.7 0zM17.1 8 14.5 10.5 5.5 2.3c.5-.3 1.1-.3 1.7 0zm3.4 2.2c.9.5.9 1.9 0 2.4L18.3 14 15.8 12l2.5-2.4z"></path></svg>
            <span><small class="block text-[10px] opacity-70">Disponible en</small><b class="font-display text-sm">Google Play</b></span>
          </a>
        </div>
        <a href="/" class="mt-6 inline-block text-sm font-medium text-brand hover:underline">Conoce Sano</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const match = window.location.pathname.match(/^\/p\/([0-9]{6,14})\/?$/);
  const barcode = match?.[1] ?? null;

  const barcodeEl = document.getElementById('barcode');
  const openApp = document.getElementById('open-app') as HTMLAnchorElement | null;
  const hint = document.getElementById('open-hint');

  if (barcode && barcodeEl && openApp) {
    barcodeEl.textContent = barcode;
    // Esquema propio de la app (app.json → "scheme": "sano"); expo-router lo lleva a /p/[barcode].
    openApp.href = `sano://p/${barcode}`;
    openApp.addEventListener('click', () => {
      // Si la app no está instalada el navegador no navega: mostramos cómo seguir.
      window.setTimeout(() => {
        if (document.visibilityState === 'visible') hint?.classList.remove('hidden');
      }, 1500);
    });
  } else if (openApp) {
    openApp.href = '/';
    openApp.textContent = 'Conoce Sano';
  }
</script>
