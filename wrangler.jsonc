{
  // Cloudflare Workers con static assets: sirve el build de Astro (`dist/`).
  // Deploy: `npm run deploy` (requiere `npx wrangler login` la primera vez).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sano-landing",
  "compatibility_date": "2026-09-01",
  // El Worker solo atiende los enlaces compartidos y el archivo de Universal Links.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/p", "/p/*", "/.well-known/apple-app-site-association"]
  }
}
